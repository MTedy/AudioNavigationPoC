<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:UiTest"
        x:Class="UiTest.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Test rozpoznawczy: Avalonia UI na .NET 10"
        Width="480" Height="260">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <StackPanel Margin="30" Spacing="20" VerticalAlignment="Center">
        <TextBlock Text="Test rozpoznawczy: Avalonia UI"
                   FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"/>

        <TextBlock Text="{Binding Status}"
                   TextWrapping="Wrap" HorizontalAlignment="Center"/>

        <Button Content="Kliknij mnie"
                Command="{Binding IncrementCommand}"
                HorizontalAlignment="Center"
                Padding="20,10"/>

        <TextBlock Text="{Binding Counter, StringFormat='Licznik: {0}'}"
                   HorizontalAlignment="Center" FontSize="16"/>
    </StackPanel>
</Window>
